# Backend configuration — copy to `.env` and fill in as needed.
# `npm run dev` loads `.env` into the backend via uvicorn --env-file.
#
# Archive / replay mode needs NONE of these. They only matter for LIVE matches.

# OpenRouter key — required for live matches (LLMs play in real time).
# Without it the server serves archived replays only.
OPENROUTER_API_KEY=

# Optional: comma-separated OpenRouter model slugs for the live roster.
# Falls back to the built-in default roster when unset.
# OPENROUTER_MODELS=anthropic/claude-3.5-sonnet,openai/gpt-4o-mini,google/gemini-2.0-flash

# Optional: the host/commentator model (defaults to x-ai/grok-2).
# HOST_MODEL=x-ai/grok-2

# Optional: seconds between matches on the live channel (dev default is 30).
# INTERMISSION_SECONDS=30
